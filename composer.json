{
    "name": "transolutions/auto-transmission-overhaul",
    "type": "project",
    "description": "Transolutions Vehicle Maintenance Management System",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-bcmath": "*",
        "laravel/framework": "^12.0",
        "barryvdh/laravel-dompdf": "^3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "platform": {"php": "8.2.12"},
        "sort-packages": true
    },
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    }
}
